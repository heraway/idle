# --- Core ---
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://idle_user:idle_pass@localhost:5432/idle_db?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- File storage (photos: before/after, checklist proof, ID docs) ---
# Swap for S3 / Cloudinary / Supabase Storage in production. Local disk is used in dev.
UPLOAD_DIR="./uploads"
PUBLIC_BASE_URL="http://localhost:4000"

# --- Payments / Escrow (STUBBED — plug in real keys to go live) ---
# This project ships with a mock escrow service so it runs for free with zero
# payment-provider signup. To go live, implement services/escrow.service.ts
# against Stripe Connect (recommended: destination charges + manual payout).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- ID Verification (STUBBED — plug in real keys to go live) ---
# Mock provider by default. For production, wire services/idVerification.service.ts
# to Stripe Identity, Persona, or Onfido. NEVER store raw ID images in your own DB;
# store only the provider's verification reference + status.
ID_VERIFICATION_PROVIDER="mock"
ID_VERIFICATION_API_KEY=""

# --- Admin seed (optional) ---
# Used by `npm run seed` (backend/prisma/seed.ts) to create the first SUPERADMIN.
# Leave both blank to get a default email (admin@idle.app) with a random,
# securely generated password printed to the console once.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
